{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.d.ts", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "lib/agents/interview-prep.ts",
    "lib/agents/match-optimize.ts",
    "lib/agents/match.ts",
    "lib/agents/planner.ts",
    "lib/agents/resume-evidence.ts",
    "lib/agents/role-research.ts",
    "lib/agents/supervisor.ts",
    "lib/agents/writer.ts",
    "lib/mcp/dice/**/*.ts",
    "lib/mcp/resume-optimizer-pro/**/*.ts",
    "lib/providers/**/*.ts"
  ]
}
