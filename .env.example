MCP_TRANSPORT=http-json
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_EMBED_MODEL=

# Resumake MCP (stdio)
ENABLE_RESUMAKE_MCP=false
RESUMAKE_MCP_COMMAND=node
RESUMAKE_MCP_ARGS=["path/to/resumake-mcp/server.js"]
RESUMAKE_MCP_CWD=
RESUMAKE_TEMPLATE_NUMBER=1

# JobSpy MCP (stdio)
ENABLE_JOBSPY_MCP=false
JOBSPY_MCP_COMMAND=node
JOBSPY_MCP_ARGS=["path/to/jobspy-mcp-server/src/index.js"]
JOBSPY_MCP_CWD=
JOBSPY_SITE_NAMES=indeed,linkedin,glassdoor
JOBSPY_COUNTRY_INDEED=USA
JOBSPY_FETCH_LINKEDIN_DESCRIPTION=false

# Decodo MCP (http-json)
ENABLE_DECODO_MCP=false
DECODO_API_KEY=
DECODO_MCP_URL=
ENABLE_CREWAI_BRIDGE=false
CREWAI_BRIDGE_URL=http://127.0.0.1:8787
CREWAI_BRIDGE_TIMEOUT_MS=12000
APP_URL=http://localhost:3000
STORAGE_MODE=local
LOCAL_DATA_DIR=./data/local
JOB_DISCOVERY_MODE=manual
RESUME_OPTIMIZER_MODE=internal
CV_STYLING_MODE=none
ENABLE_EMBEDDINGS=false
NEXT_PUBLIC_ENABLE_JOB_SEARCH=true
